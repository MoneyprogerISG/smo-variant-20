@startuml flowchart
title Flowchart с дорожками — СМО «Склад погрузки грузовиков», вариант 20

skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #444444
skinparam swimlaneWidth same

|Календарь событий|
start
:Инициализация: n источников, m погрузчиков,
буфер на k мест, указатель приборов ptr = 0;
:Для каждого источника запланировать
первую генерацию t1 = a + (b − a)·R (ИЗ2);
repeat
  :Взять ближайшее особое событие,
  модельное время t := время события;
  if (Тип события?) then (GENERATION)
    |Источник (грузовик)|
    :Создать заявку Зi.k
    (№ источника, № заявки, tGen = t);
    :Запланировать следующую генерацию
    tNext = t + a + (b − a)·R  (ИБ, ИЗ2);
    :Учёт: заявка сгенерирована;
    |Диспетчер постановки|
    :Запросить свободный погрузчик;
    |Погрузчики|
    :Поиск свободного по кольцу,
    начиная с указателя ptr (Д2П2);
    if (Свободный погрузчик Пj найден?) then (да — HappyFlow)
      :ptr := (j + 1) mod m;
      :Начать погрузку Зi.k на Пj,
      tОбсл = −(1/λ)·ln(R)  (ПЗ1);
      :Запланировать RELEASE(Пj, t + tОбсл);
    else (нет — все заняты)
      |Буфер|
      if (Буфер полон?) then (нет)
        :Поставить Зi.k в конец очереди (Д1ОЗ2);
      else (да)
        :Выбить последнюю поступившую в буфер
        заявку — хвост очереди (Д1ОО4);
        :Учёт: отказ выбитой заявки;
        :Поставить Зi.k в конец очереди (Д1ОЗ2);
      endif
    endif
  else (RELEASE)
    |Погрузчики|
    :Завершить погрузку на Пj,
    Пj становится свободным;
    :Учёт: заявка обслужена,
    время занятости Пj;
    |Диспетчер выбора|
    if (В буфере есть заявки?) then (да)
      |Буфер|
      :Выбрать заявку, дольше всех стоящую
      в очереди — голову (Д2Б1, FIFO);
      :Сдвинуть оставшиеся заявки
      на одно место (Д1ОЗ2);
      |Погрузчики|
      :Поиск свободного по кольцу от ptr (Д2П2),
      ptr := (j + 1) mod m;
      :Начать погрузку,
      tОбсл = −(1/λ)·ln(R)  (ПЗ1);
      :Запланировать RELEASE(Пj', t + tОбсл);
    else (нет)
      |Диспетчер выбора|
      :Погрузчик простаивает
      до следующего события;
    endif
  endif
  |Календарь событий|
  if (Пошаговый режим?) then (да)
    :Показать формализованную схему и состояние (ОД2):
    источники, буфер, погрузчики, указатель,
    календарь событий, % отказа;
  else (нет)
  endif
repeat while (Сгенерировано заявок < N\nили в системе остались заявки?) is (да) not (нет)
:Сформировать сводную таблицу результатов (ОР1):
P(отказа), ср. время ожидания/обслуживания/пребывания,
загрузка погрузчиков;
stop
@enduml
